{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NGM Desktop",
  "version": "0.1.0",
  "identifier": "app.ngmpeon.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NGM Desktop",
        "width": 460,
        "height": 600,
        "minWidth": 400,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Keeps NGM Peon and the NGM addon in sync",
    "longDescription": "The desktop app for NGM Peon (ngmpeon.app) and the Nootropic Guild Manager addon for WoW: Forever. When WoW saves NGM's data, it sends NGM Peon what changed in game, and keeps NGM Peon's news ready for the addon.",
    "publisher": "keasbeexd",
    "homepage": "https://ngmpeon.app",
    "copyright": "Copyright (c) 2026 Marc @keasbeexd",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxQTMxMzRGNDQxMjI5M0EKUldRNktSSkVUeE9qY1Qxb2V6L3h4NENoZFlyTms2aEI4Zll1YW1qS1JmRlB2Q293YXU1cHNjWlAK",
      "endpoints": [
        "https://github.com/keasbeexd/ngm-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
